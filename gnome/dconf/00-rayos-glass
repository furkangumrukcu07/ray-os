# Ray OS macOS Frosted Glass Default Configuration (dconf)

[org/gnome/shell]
enabled-extensions=['blur-my-shell@aunetx', 'dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.gnome.Software.desktop', 'opera.desktop', 'org.gnome.Nautilus.desktop', 'vlc.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop', 'calamares.desktop']

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark-glassy'

[org/gnome/shell/extensions/blur-my-shell]
brightness=0.88
sigma=35
blur-dash=true
blur-panel=true
blur-overview=true
blur-lockscreen=true
appfolder-blur=true

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
brightness=0.85
sigma=30
override-background-and-borders=true

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true
brightness=0.75
sigma=40
override-background=true

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
transparency-mode='FIXED'
background-opacity=0.22
dash-max-icon-size=52
show-mounts=false
show-trash=true
show-apps-at-top=true
custom-theme-shrink=true
running-indicator-style='DOTS'
running-indicator-dominant-color=false

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='WhiteSur-Dark-glassy'
icon-theme='WhiteSur-dark'
cursor-theme='WhiteSur-cursors'
font-name='Inter 10.5'
document-font-name='Inter 10.5'
monospace-font-name='JetBrains Mono 10'
clock-show-weekday=true
clock-format='24h'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/rayos/ray_glassmorphism.jpg'
picture-uri-dark='file:///usr/share/backgrounds/rayos/ray_glassmorphism.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/rayos/ray_glassmorphism.jpg'

# macOS Window Controls on LEFT (Red, Yellow, Green Traffic Lights)
[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
focus-mode='click'

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true
edge-tiling=true
experimental-features=['scale-monitor-framebuffer']
